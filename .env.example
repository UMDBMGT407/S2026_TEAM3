# Copy to .env and adjust. Never commit real .env with secrets.

SECRET_KEY=
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=motivdata

# Production: full public origin, no trailing slash (must match a hostname that resolves in DNS).
# BMGT407 teams are typically https://s<section>t<team>.rhsmith.umd.edu (not bmgts... unless IT assigns it).
PUBLIC_BASE_URL=https://s101t03.rhsmith.umd.edu

# Optional: force secure session cookies if you use HTTPS but leave PUBLIC_BASE_URL unset.
# SESSION_COOKIE_SECURE=1

# Optional: trust X-Forwarded-* from Apache/nginx (also enabled when PUBLIC_BASE_URL is https://).
# TRUST_PROXY_HEADERS=1
